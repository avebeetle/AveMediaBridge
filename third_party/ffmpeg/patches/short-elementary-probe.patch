diff --git a/libavformat/aacdec.c b/libavformat/aacdec.c
index 0b4bd69..695607d 100644
--- a/libavformat/aacdec.c
+++ b/libavformat/aacdec.c
@@ -32,6 +32,31 @@
 
 #define ADTS_HEADER_SIZE 7
 
+/* Two matching, complete frames can beat an incidental sync word in their
+ * payload. Keep the score below the retry threshold for larger files. */
+static int complete_adts_pair(const AVProbeData *p)
+{
+    const uint8_t *frame = p->buf;
+    int remaining = p->buf_size;
+
+    for (int i = 0; i < 2; i++) {
+        int size;
+        if (remaining <= ADTS_HEADER_SIZE || (AV_RB16(frame) & 0xfff6) != 0xfff0 ||
+            ((frame[2] >> 2) & 15) >= 13 || !(AV_RB16(frame + 2) & 0x01c0) ||
+            (frame[6] & 3))
+            return 0;
+        /* Match MPEG ID, protection, profile, frequency and channels. */
+        if ((AV_RB32(frame) ^ AV_RB32(p->buf)) & 0xfffffdc0)
+            return 0;
+        size = (AV_RB32(frame + 3) >> 13) & 0x1fff;
+        if (size <= ADTS_HEADER_SIZE + 2 * !(frame[1] & 1) || size > remaining)
+            return 0;
+        frame += size;
+        remaining -= size;
+    }
+    return !remaining;
+}
+
 static int adts_aac_probe(const AVProbeData *p)
 {
     int max_frames = 0, first_frames = 0;
@@ -75,6 +100,8 @@ static int adts_aac_probe(const AVProbeData *p)
         return AVPROBE_SCORE_EXTENSION;
     else if (max_frames >= 3)
         return AVPROBE_SCORE_EXTENSION / 2;
+    else if (first_frames == 2 && complete_adts_pair(p))
+        return 2;
     else if (first_frames >= 1)
         return 1;
     else
